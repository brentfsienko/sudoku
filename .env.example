# Liveblocks realtime (https://liveblocks.io/dashboard) — required for 2-player modes.
# Single-player works without this.
LIVEBLOCKS_SECRET_KEY=sk_dev_xxxxxxxxxxxxxxxxxxxxxxxx

# Canonical URL for link previews (optional; Vercel sets VERCEL_URL automatically).
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Supabase (https://supabase.com) — enables login + cross-device stats sync.
# Stats fall back to on-device localStorage when these are missing.
# Run supabase/trivia.sql in the SQL editor for today's-fact guess percentages.
# Project Settings → API Keys (use the publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Secret / service-role key — required for daily leaderboard writes from the API.
# Project Settings → API Keys → secret key (or legacy service_role).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Reddit Ads pixel (Events Manager → Pixel ID). Public; baked in at build time.
NEXT_PUBLIC_REDDIT_PIXEL_ID=a2_je9pixk0jvxe

# Resend (https://resend.com) — custom branded auth emails via Supabase Auth Hook.
# 1. Add your Resend API key and verified sender address below.
# 2. In Supabase Dashboard → Authentication → Hooks → "Send Email", set the URL to:
#    https://sudogku.com/api/auth/send-email
# 3. Copy the hook secret shown after saving and paste it as SEND_EMAIL_HOOK_SECRET.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=Sudogku <hello@sudogku.com>
SEND_EMAIL_HOOK_SECRET=v1,whsec_xxxxxxxxxxxx
